{
  "name": "@react-native-ml-kit/text-recognition",
  "title": "React Native ML Kit Text Recognition",
  "version": "2.0.0",
  "description": "React Native On-Device Text Recognition w/ Google ML Kit",
  "main": "src/index.ts",
  "files": [
    "README.md",
    "android",
    "src",
    "ios",
    "text-recognition.podspec"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a7med-mahmoud/react-native-ml-kit.git",
    "baseUrl": "https://github.com/a7med-mahmoud/react-native-ml-kit"
  },
  "keywords": [
    "react-native"
  ],
  "author": {
    "name": "Ahmed Mahmoud",
    "email": "a7med.mahmoud2004@gmail.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.1",
    "react-native": ">=0.60.0-rc.0 <1.0.x"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.23",
    "@types/react-native": "^0.72.3",
    "babel-jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.76.9",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.72.6",
    "ts-jest": "^29.1.4",
    "typescript": "^5.3.3"
  },
  "codegenConfig": {
    "name": "TextRecognitionSpec",
    "type": "modules",
    "jsSrcsDir": "./src"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-native"
          }
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/node_modules/react-native"
    },
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
